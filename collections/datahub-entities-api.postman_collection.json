        {
          "id": "42b0bad7-251c-46da-bc39-f85091990073",
          "name": "DataHub Delete entities",
          "request": {
            "name": "DataHub Delete entities",
            "description": {
              "content": "Delete one or more entities from the DataHub metadata graph. Supports both soft deletes (marking entities as removed while preserving metadata) and hard deletes (permanently removing all entity metadata). Soft delete is the default behavior.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "entities",
                "v1",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "urns",
                  "value": "<string>",
                  "description": "(Required) One or more entity URNs to operate on. Only a single entity type may be queried per request. URNs follow the format urn:li:{entityType}:{key}."
                },
                {
                  "disabled": false,
                  "key": "urns",
                  "value": "<string>",
                  "description": "(Required) One or more entity URNs to operate on. Only a single entity type may be queried per request. URNs follow the format urn:li:{entityType}:{key}."
                },
                {
                  "disabled": false,
                  "key": "soft",
                  "value": "true",
                  "description": "Whether to perform a soft delete (marking the entity as removed while preserving metadata) or a hard delete (permanently removing all metadata). Defaults to true (soft delete)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
